        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n    USERS {\n        int user_id PK\n        string email UK\n        string password_hash\n        string first_name\n        string last_name\n        string phone\n        string account_type\n        string company_name\n        string tax_id\n        boolean is_active\n        datetime created_at\n        datetime updated_at\n    }\n\n    ROLES {\n        int role_id PK\n        string role_name UK\n        string description\n    }\n\n    USER_ROLES {\n        int user_id PK, FK\n        int role_id PK, FK\n        datetime assigned_at\n    }\n\n    CATEGORIES {\n        int category_id PK\n        string name UK\n        string description\n        int parent_category_id FK\n    }\n\n    PRODUCTS {\n        int product_id PK\n        int seller_id FK\n        string name\n        string description\n        decimal price\n        int stock_quantity\n        string unit\n        string status\n        datetime created_at\n        datetime updated_at\n    }\n\n    PRODUCT_CATEGORIES {\n        int product_id PK, FK\n        int category_id PK, FK\n    }\n\n    CARTS {\n        int cart_id PK\n        int customer_id FK, UK\n        datetime created_at\n        datetime updated_at\n    }\n\n    CART_ITEMS {\n        int cart_item_id PK\n        int cart_id FK\n        int product_id FK\n        int quantity\n        datetime added_at\n    }\n\n    ORDERS {\n        int order_id PK\n        int customer_id FK\n        datetime order_date\n        string status\n        decimal total_amount\n        string shipping_address\n        string notes\n    }\n\n    ORDER_ITEMS {\n        int order_item_id PK\n        int order_id FK\n        int product_id FK\n        int seller_id FK\n        int quantity\n        decimal unit_price\n        decimal subtotal\n        string status\n    }\n\n    PAYMENTS {\n        int payment_id PK\n        int order_id FK\n        decimal amount\n        string payment_method\n        string status\n        string transaction_reference UK\n        datetime created_at\n    }\n\n    STOCK_RESERVATIONS {\n        int reservation_id PK\n        int order_item_id FK\n        int quantity\n        string status\n        datetime reserved_at\n        datetime expires_at\n    }\n\n    SHIPMENTS {\n        int shipment_id PK\n        int order_item_id FK, UK\n        string tracking_number UK\n        string shipping_address\n        string status\n        datetime shipped_at\n        datetime delivered_at\n        datetime created_at\n    }\n\n    REVIEWS {\n        int review_id PK\n        int customer_id FK\n        int product_id FK\n        int order_item_id FK, UK\n        int rating\n        string comment\n        datetime created_at\n    }\n\n    NOTIFICATIONS {\n        int notification_id PK\n        int user_id FK\n        string title\n        string message\n        boolean is_read\n        datetime created_at\n    }\n\n    AUDIT_LOGS {\n        int log_id PK\n        int user_id FK\n        string action\n        string entity_type\n        int entity_id\n        string details\n        datetime created_at\n    }\n\n    SUPPORT_TICKETS {\n        int ticket_id PK\n        int user_id FK\n        int assigned_to FK\n        string subject\n        string description\n        string status\n        datetime created_at\n        datetime updated_at\n    }\n\n    REPORTS {\n        int report_id PK\n        int reported_by FK\n        int product_id FK\n        int review_id FK\n        string reason\n        string status\n        datetime created_at\n    }\n\n    USERS ||--o| CARTS : owns\n    USERS ||--o{ ORDERS : places\n    USERS ||--o{ PRODUCTS : sells\n    USERS ||--o{ ORDER_ITEMS : seller\n    USERS ||--o{ REVIEWS : writes\n    USERS ||--o{ NOTIFICATIONS : receives\n    USERS o|--o{ AUDIT_LOGS : performs\n    USERS ||--o{ REPORTS : submits\n    USERS ||--o{ SUPPORT_TICKETS : creates\n    USERS o|--o{ SUPPORT_TICKETS : assigned\n    USERS ||--o{ USER_ROLES : has\n    ROLES ||--o{ USER_ROLES : assigned\n\n    CARTS ||--o{ CART_ITEMS : contains\n    PRODUCTS ||--o{ CART_ITEMS : added_to\n    ORDERS ||--o{ ORDER_ITEMS : contains\n    PRODUCTS ||--o{ ORDER_ITEMS : ordered\n    ORDERS ||--o{ PAYMENTS : has\n\n    PRODUCTS ||--o{ PRODUCT_CATEGORIES : categorized\n    CATEGORIES ||--o{ PRODUCT_CATEGORIES : contains\n    CATEGORIES o|--o{ CATEGORIES : parent_of\n\n    ORDER_ITEMS ||--o| REVIEWS : reviewed\n    ORDER_ITEMS ||--o| SHIPMENTS : shipped\n    ORDER_ITEMS ||--o{ STOCK_RESERVATIONS : reserved\n\n    PRODUCTS ||--o{ REVIEWS : receives\n    PRODUCTS o|--o{ REPORTS : reported\n    REVIEWS o|--o{ REPORTS : reported\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="9TePQSut0AvXl6CKpEuy-1003">
